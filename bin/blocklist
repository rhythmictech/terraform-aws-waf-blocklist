#!/usr/bin/env python3
"""Manage entries in a WAF blocklist table (see terraform-aws-waf-blocklist).

    blocklist add 203.0.113.7 --reason "credential stuffing" --ticket OPS-123
    blocklist add 198.51.100.0/24 --reason "scanner range" --expires 7d
    blocklist add 203.0.113.9 --reason "known bad" --expires never
    blocklist list            # active entries
    blocklist list --all      # including expired/removed
    blocklist extend 203.0.113.7 --expires 30d
    blocklist remove 203.0.113.7 --reason "customer confirmed legitimate"

Entries expire after 90 days unless --expires is given. "remove" expires the
entry immediately but keeps the row, so the history of why an address was
blocked and unblocked stays in the table. The reconciler picks up every change
within seconds.

The table name comes from --table or the BLOCKLIST_TABLE environment variable.
Uses the ambient AWS credentials and region (AWS_PROFILE, AWS_REGION).
"""

import argparse
import ipaddress
import json
import os
import re
import sys
from datetime import datetime, timedelta, timezone

import boto3
from botocore.exceptions import ClientError

DEFAULT_EXPIRY = "90d"
DURATION_RE = re.compile(r"^(\d+)([hdw])$")
DURATION_UNITS = {"h": "hours", "d": "days", "w": "weeks"}


def now():
    return datetime.now(timezone.utc).replace(microsecond=0)


def iso(ts):
    return ts.isoformat().replace("+00:00", "Z")


def parse_expires(value):
    """'never' -> None; '30d'/'12h'/'2w' -> relative; otherwise an ISO date or datetime."""
    if value.lower() == "never":
        return None
    match = DURATION_RE.match(value)
    if match:
        return now() + timedelta(**{DURATION_UNITS[match.group(2)]: int(match.group(1))})
    ts = datetime.fromisoformat(value.replace("Z", "+00:00"))
    if ts.tzinfo is None:
        ts = ts.replace(tzinfo=timezone.utc)
    if ts <= now():
        sys.exit(f"error: {value} is in the past")
    return ts


def normalize_cidr(raw):
    try:
        network = ipaddress.ip_network(raw, strict=False)
    except ValueError:
        sys.exit(f"error: {raw!r} is not an IP address or CIDR")
    canonical = str(network)
    if "/" in raw and canonical != raw:
        print(f"note: normalized {raw} to {canonical}", file=sys.stderr)
    return canonical


def caller_identity():
    try:
        return boto3.client("sts").get_caller_identity()["Arn"]
    except Exception:  # noqa: BLE001 - attribution only, never block the write
        return os.environ.get("USER", "unknown")


def is_active(item, at):
    expires_at = item.get("expires_at")
    if not expires_at:
        return True
    return datetime.fromisoformat(expires_at.replace("Z", "+00:00")) > at


def scan_all(table):
    items = []
    kwargs = {}
    while True:
        page = table.scan(**kwargs)
        items.extend(page.get("Items", []))
        if "LastEvaluatedKey" not in page:
            break
        kwargs["ExclusiveStartKey"] = page["LastEvaluatedKey"]
    return items


def cmd_add(table, args):
    cidr = normalize_cidr(args.cidr)
    expires = parse_expires(args.expires)
    item = {
        "cidr": cidr,
        "reason": args.reason,
        "added_by": args.added_by or caller_identity(),
        "added_at": iso(now()),
    }
    if args.ticket:
        item["ticket"] = args.ticket
    if expires is not None:
        item["expires_at"] = iso(expires)
    table.put_item(Item=item)
    until = item.get("expires_at", "never")
    print(f"blocked {cidr} until {until}")


def update_existing(table, cidr, update, values):
    try:
        table.update_item(
            Key={"cidr": cidr},
            UpdateExpression=update,
            ConditionExpression="attribute_exists(cidr)",
            ExpressionAttributeValues=values,
        )
    except ClientError as exc:
        if exc.response["Error"]["Code"] == "ConditionalCheckFailedException":
            sys.exit(f"error: {cidr} is not in the table")
        raise


def cmd_extend(table, args):
    cidr = normalize_cidr(args.cidr)
    expires = parse_expires(args.expires)
    if expires is None:
        update = "SET permanent_by = :who REMOVE expires_at"
        values = {":who": caller_identity()}
    else:
        update = "SET expires_at = :exp, extended_by = :who"
        values = {":exp": iso(expires), ":who": caller_identity()}
    update_existing(table, cidr, update, values)
    print(f"{cidr} now expires {iso(expires) if expires else 'never'}")


def cmd_remove(table, args):
    cidr = normalize_cidr(args.cidr)
    update_existing(
        table,
        cidr,
        "SET expires_at = :now, removed_at = :now, removed_by = :who, removed_reason = :why",
        {":now": iso(now()), ":who": caller_identity(), ":why": args.reason or ""},
    )
    print(f"unblocked {cidr}")


def cmd_show(table, args):
    cidr = normalize_cidr(args.cidr)
    item = table.get_item(Key={"cidr": cidr}).get("Item")
    if not item:
        sys.exit(f"{cidr} is not in the table")
    print(json.dumps(item, indent=2, sort_keys=True, default=str))


def cmd_list(table, args):
    at = now()
    items = sorted(scan_all(table), key=lambda i: i["cidr"])
    if not args.all:
        items = [i for i in items if is_active(i, at)]
    if args.json:
        print(json.dumps(items, indent=2, sort_keys=True, default=str))
        return
    if not items:
        print("no entries")
        return
    width = max(len(i["cidr"]) for i in items)
    print(f"{'CIDR':<{width}}  {'EXPIRES':<20}  {'TICKET':<12}  REASON")
    for item in items:
        expires = item.get("expires_at", "never")
        if not is_active(item, at):
            expires = f"expired {expires[:10]}"
        print(
            f"{item['cidr']:<{width}}  {expires:<20}  {item.get('ticket', ''):<12}  {item.get('reason', '')}"
        )


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--table", default=os.environ.get("BLOCKLIST_TABLE"), help="DynamoDB table name (or set BLOCKLIST_TABLE)")
    sub = parser.add_subparsers(dest="command", required=True)

    add = sub.add_parser("add", help="block an address or CIDR")
    add.add_argument("cidr")
    add.add_argument("--reason", required=True, help="why this is blocked; reference the incident or ticket")
    add.add_argument("--ticket", help="ticket or case id")
    add.add_argument("--expires", default=DEFAULT_EXPIRY, help=f"30d, 12h, 2w, an ISO date, or never (default {DEFAULT_EXPIRY})")
    add.add_argument("--added-by", help="defaults to the caller's IAM identity")
    add.set_defaults(func=cmd_add)

    extend = sub.add_parser("extend", help="change an entry's expiry")
    extend.add_argument("cidr")
    extend.add_argument("--expires", required=True, help="30d, 12h, 2w, an ISO date, or never")
    extend.set_defaults(func=cmd_extend)

    remove = sub.add_parser("remove", help="unblock now, keeping the row for history")
    remove.add_argument("cidr")
    remove.add_argument("--reason", help="why it is being unblocked")
    remove.set_defaults(func=cmd_remove)

    show = sub.add_parser("show", help="print one entry")
    show.add_argument("cidr")
    show.set_defaults(func=cmd_show)

    lst = sub.add_parser("list", help="list entries")
    lst.add_argument("--all", action="store_true", help="include expired and removed entries")
    lst.add_argument("--json", action="store_true")
    lst.set_defaults(func=cmd_list)

    args = parser.parse_args()
    if not args.table:
        parser.error("--table or BLOCKLIST_TABLE is required")
    table = boto3.resource("dynamodb").Table(args.table)
    args.func(table, args)


if __name__ == "__main__":
    main()
